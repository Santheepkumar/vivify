---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { company } from '../data/company';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Vivify Signage | LED & Glow Sign Boards Manufacturer Coimbatore",
  description = "Premier manufacturer of LED Glow Sign Boards, 3D Acrylic Letters, ACP Elevation, and architectural signage in Coimbatore, Tamil Nadu.",
  image = "/images/logo.png"
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://vivifysignage.com');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Vivify Signage Coimbatore" />
    <meta name="keywords" content="Signage Coimbatore, LED Glow Boards Coimbatore, 3D Acrylic Letters, ACP Elevation Coimbatore, Commercial Shopfront Signs, Ganapathy Signage, CNC cutting signage" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Schema.org LocalBusiness markup -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": company.name,
      "image": "https://vivifysignage.com/images/logo.png",
      "telephone": company.phone,
      "email": company.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": company.address.street,
        "addressLocality": company.address.city,
        "addressRegion": company.address.state,
        "postalCode": company.address.pincode,
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 11.0425,
        "longitude": 76.9740
      },
      "url": "https://vivifysignage.com",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:30",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:30",
          "closes": "14:00"
        }
      ],
      "priceRange": "$$"
    })} />
  </head>
  <body class="bg-[#07090e] text-slate-100 selection:bg-[#f59e0b] selection:text-black min-h-dvh flex flex-col font-sans">
    
    <!-- Skip to content for keyboard accessibility -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#f59e0b] focus:text-black focus:font-bold focus:rounded"
    >
      Skip to content
    </a>

    <Navbar currentPath={currentPath} />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />
    
    <WhatsAppButton />

    <!-- Botpress Chatbot -->
    <script is:inline src="https://cdn.botpress.cloud/webchat/v5.0/inject.js"></script>
    <script is:inline src="https://files.bpcontent.cloud/2026/11/17/15/20261117153158-3C369KZD.js" defer></script>
  </body>
</html>
