---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { company } from '../data/company';

const faqs = [
  {
    q: "Do you offer free on-site physical measurement in Coimbatore?",
    a: "Yes. Our fabrication engineers visit your site in Coimbatore, Tiruppur, and surrounding districts to inspect elevation structures, calculate viewing distances, and measure dimensions before quotation."
  },
  {
    q: "What is the typical fabrication and installation turnaround time?",
    a: "Standard LED Glow signboards and 3D Acrylic letters take 3 to 5 business days from design approval. Comprehensive multi-story ACP elevation cladding projects typically take 7 to 14 days depending on total square footage."
  },
  {
    q: "Are Vivify LED signboards weatherproof during heavy monsoons?",
    a: "Absolutely. We exclusively use IP67 waterproof-rated LED modules, anti-corrosive galvanized structural frames, and weather-sealed silicone joints designed to withstand high winds and direct rainfall."
  },
  {
    q: "What warranty do you provide on LED drivers and modules?",
    a: "We provide up to a 2 to 3-year warranty on Samsung/Osram LED modules and certified MeanWell power supplies. We also offer on-call maintenance support across Coimbatore."
  }
];
---

<Layout
  title="Contact Us | Vivify Signage Coimbatore"
  description="Contact Vivify Signage in Ganapathy, Coimbatore. Call +91 79045 40645 or request a free quote for 3D Acrylic letters, LED glow signs, and ACP elevation."
>
  <!-- Page Header -->
  <section class="relative py-20 lg:py-28 overflow-hidden  bg-[#07090e]">
    <div class="pointer-events-none absolute inset-0 bg-grid-pattern opacity-30"></div>
    <div class="pointer-events-none absolute top-1/4 left-1/3 h-96 w-96 rounded-full bg-[#f59e0b]/10 blur-[130px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#f59e0b]/30 bg-[#f59e0b]/10 px-3.5 py-1.5 text-xs font-semibold font-semibold text-[#f59e0b]">
        Get in Touch
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-black tracking-tight text-white max-w-3xl leading-tight">
        Connect With Our Signage Workshop
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        Speak directly with our senior fabrication specialists in Coimbatore. We're ready to inspect your site, draft 3D lighting previews, and deliver exact estimates.
      </p>
    </div>
  </section>

  <!-- Contact Grid & Form -->
  <section class="py-16 lg:py-24 bg-[#090b10]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left: Contact Details & Hours -->
        <div class="lg:col-span-5 space-y-8">
          
          <!-- Quick Call Card -->
          <div class="rounded-2xl bg-[#0c101a] p-6 space-y-3">
            <span class="text-xs text-[#f59e0b] font-semibold">Direct Telephone</span>
            <div class="text-2xl font-display font-extrabold text-white">
              <a href={`tel:${company.phoneRaw}`} class="hover:text-[#f59e0b] transition-colors">
                {company.phone}
              </a>
            </div>
            <p class="text-xs text-slate-400">Available Mon–Sat during operating hours for immediate project consultations.</p>
          </div>

          <!-- Address & Workshop Location Card -->
          <div class="rounded-2xl border border-[#1e283d] bg-[#0c101a] p-6 space-y-4">
            <h3 class="font-display text-lg font-bold text-white flex items-center gap-2">
              <svg class="h-5 w-5 text-[#f59e0b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Workshop Location
            </h3>
            
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              {company.address.full}
            </p>

            <div class="pt-2 ">
              <a
                href={`https://maps.google.com/?q=${company.address.mapQuery}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#f59e0b] hover:underline"
              >
                <span>Open in Google Maps</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <!-- Business Operating Hours Card -->
          <div class="rounded-2xl border border-[#1e283d] bg-[#0c101a] p-6 space-y-3">
            <h3 class="font-display text-lg font-bold text-white flex items-center gap-2">
              <svg class="h-5 w-5 text-[#f59e0b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Operating Hours
            </h3>
            
            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between pt-1">
                <span class="text-slate-400">Monday – Friday:</span>
                <span class="text-white font-medium">{company.hours.weekdays}</span>
              </div>
              <div class="flex items-center justify-between pt-2">
                <span class="text-slate-400">Saturday:</span>
                <span class="text-white font-medium">{company.hours.saturday}</span>
              </div>
              <div class="flex items-center justify-between pt-2">
                <span class="text-slate-400">Sunday:</span>
                <span class="text-rose-400 font-medium">{company.hours.sunday}</span>
              </div>
            </div>
          </div>

          <!-- Email Card -->
          <div class="rounded-2xl bg-[#0c101a] p-6 space-y-2">
            <span class="text-xs text-slate-400 font-semibold">Email Blueprint Submissions</span>
            <div class="text-sm font-semibold text-white">
              <a href={`mailto:${company.email}`} class="hover:text-[#f59e0b] transition-colors">
                {company.email}
              </a>
            </div>
          </div>

        </div>

        <!-- Right: Quote Request Form -->
        <div id="quote" class="lg:col-span-7">
          <QuoteForm />
        </div>

      </div>

      <!-- FAQ Section -->
      <div class="mt-24 pt-16  space-y-12">
        <div class="max-w-2xl space-y-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800/40 px-3 py-1 text-xs font-semibold font-semibold text-slate-300">
            Frequently Asked Questions
          </div>
          <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Signage Engineering & Ordering FAQs
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-[#1e283d] bg-[#0c101a] p-6 space-y-2">
              <h3 class="font-display text-base font-bold text-white">
                {faq.q}
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
