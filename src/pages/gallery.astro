---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { company } from '../data/company';
import { galleryProjects } from '../data/gallery';
---

<Layout
  title="Signage Portfolio & Gallery | Vivify Signage Coimbatore"
  description="Explore our gallery of completed 3D Acrylic letters, LED Glow Sign Boards, ACP Elevation facades, and commercial storefront branding across Coimbatore and Tamil Nadu."
>
  <!-- Page Header -->
  <section class="relative py-20 lg:py-28 overflow-hidden  bg-[#07090e]">
    <div class="pointer-events-none absolute inset-0 bg-grid-pattern opacity-30"></div>
    <div class="pointer-events-none absolute top-1/4 right-1/4 h-96 w-96 rounded-full bg-[#f59e0b]/10 blur-[130px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#f59e0b]/30 bg-[#f59e0b]/10 px-3.5 py-1.5 text-xs font-semibold font-semibold text-[#f59e0b]">
        Completed Installations ({galleryProjects.length}+ Projects)
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-black tracking-tight text-white max-w-3xl leading-tight">
        Architectural Signage Portfolio
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        Browse real on-site installations of illuminated 3D acrylic letters, modern ACP exterior cladding, commercial glow boards, and wayfinding signage built for businesses in South India.
      </p>
    </div>
  </section>

  <!-- Gallery Main Section -->
  <section class="py-16 lg:py-24 bg-[#090b10]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Filterable Grid with Lightbox -->
      <GalleryGrid showFilters={true} />

      <!-- Blueprint Submission Callout -->
      <div class="mt-20 rounded-3xl border border-[#1e283d] bg-[#0e1320] p-8 sm:p-12 text-center space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#38bdf8]/30 bg-[#38bdf8]/10 px-3.5 py-1 text-xs font-semibold font-semibold text-[#38bdf8]">
          Architects & Interior Designers
        </div>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Have an Architect's Drawing or Vector Logo?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Send us your AutoCAD DWG, Illustrator AI, or PDF elevation drawings. Our CNC routing and laser cutting operators will provide exact material bills and lighting mockups within 24 hours.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={company.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-7 py-3.5 text-xs font-bold font-semibold text-black  hover:bg-[#20ba59] transition-all"
          >
            <span>Send Blueprint on WhatsApp</span>
            <span>→</span>
          </a>

          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-xl bg-[#131926] border border-[#2b3954] px-6 py-3.5 text-xs font-bold font-semibold text-white hover:bg-[#1a2336] transition-colors"
          >
            Visit Ganapathy Workshop
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
