---
import Layout from '../layouts/Layout.astro';
import GlowSimulator from '../components/GlowSimulator.astro';
import ServiceCard from '../components/ServiceCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { services } from '../data/services';
import { galleryProjects } from '../data/gallery';
import { company } from '../data/company';

const featuredServices = services.slice(0, 4);
const spotlightProjects = galleryProjects.filter(p => p.featured).slice(0, 6);
---

<Layout 
  title="Vivify Signage | Architectural LED & Glow Sign Boards Manufacturer Coimbatore"
  description="Premier manufacturer of LED Glow Sign Boards, 3D Acrylic Letters, ACP Elevation, and architectural signage in Coimbatore, Tamil Nadu. Fast turnaround and all-weather durability."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-[#07090e] pt-10 pb-16 lg:pt-16 lg:pb-24">
    <!-- Ambient architectural backdrop effects -->
    <div class="pointer-events-none absolute inset-0 bg-grid-pattern opacity-30"></div>
    <div class="pointer-events-none absolute top-10 left-1/3 h-[500px] w-[500px] rounded-full bg-[#f59e0b]/10 blur-[140px]"></div>
    <div class="pointer-events-none absolute top-1/4 right-10 h-80 w-80 rounded-full bg-[#38bdf8]/10 blur-[120px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Top 2-Column Hero Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Hero Content Column (7 cols) -->
        <div class="lg:col-span-7 space-y-6 text-left">
          
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-[#f59e0b]/40 bg-[#f59e0b]/10 px-4 py-1.5 text-xs font-semibold text-[#f59e0b]">
            <span class="flex h-2 w-2 rounded-full bg-emerald-400"></span>
            <span>Coimbatore's Premier Signage Fabrication Workshop</span>
          </div>

          <!-- Confident 2-Line Headline -->
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.12]">
            Architectural Signage &<br class="hidden sm:inline" />
            <span class="text-[#f59e0b] glow-amber-text">Precision LED Craft</span>
          </h1>

          <!-- Subtitle / Value Proposition -->
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-xl">
            From diamond-smooth 3D acrylic letters and high-lumen LED glow signboards to complete commercial ACP exterior elevation. Built to command attention 24/7 and engineered to endure monsoon weather.
          </p>

          <!-- Action Buttons Group -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href={company.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-[#f59e0b] px-7 py-4 text-xs font-bold text-black hover:bg-[#fbbf24] transition-colors active:scale-95 cursor-pointer"
            >
              <span>Direct WhatsApp Inquiry</span>
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.076-1.528-.276-.902-.355-1.597-.91-2.072-1.428-.475-.518-.94-1.33-.94-2.193 0-.863.454-1.288.618-1.464.164-.176.359-.22.478-.22.12 0 .24.002.345.008.11.006.257-.042.403.31.15.361.512 1.25.557 1.341.045.091.075.197.015.316-.06.12-.09.195-.179.3-.09.105-.189.234-.27.315-.09.09-.185.188-.08.368.106.18.47 775 1.009 1.254.693.617 1.278.808 1.458.898.18.09.285.075.39-.045.106-.12.45-.525.57-.705.12-.18.24-.15.405-.09.165.06 1.05.495 1.23.585.18.09.3.135.345.21.045.075.045.435-.099.84z"/>
              </svg>
            </a>

            <a
              href="/gallery"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#131926] border border-[#2b3954] px-6 py-4 text-xs font-bold text-white hover:bg-[#1a2336] transition-colors"
            >
              <span>Explore Portfolio ({galleryProjects.length}+ Works)</span>
              <span>→</span>
            </a>
          </div>

          <!-- Micro Trust Anchor -->
          <div class="pt-2 flex items-center gap-2 text-xs text-slate-400">
            <svg class="h-4 w-4 text-[#f59e0b] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Need site survey in Coimbatore?</span>
            <a href={`tel:${company.phoneRaw}`} class="text-[#f59e0b] font-bold hover:underline">
              Call {company.phone}
            </a>
          </div>
        </div>

        <!-- Right Hero Visual Showcase (5 cols) -->
        <div class="lg:col-span-5 w-full">
          <div class="relative overflow-hidden rounded-3xl border border-[#1e283d] bg-[#0c101a] p-3">
            <!-- Large Hero Photograph: Real night illumination installation -->
            <div class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl bg-[#07090e]">
              <img
                src="/images/signage/1000504407.jpg"
                alt="Vivify Signage Commercial LED Installation at Night"
                class="h-full w-full object-cover object-center"
              />
              <div class="absolute inset-0 bg-[#07090e]/20"></div>
            </div>

            <!-- Floating Overlay Card -->
            <div class="mt-3 rounded-xl bg-[#07090e] border border-[#1e283d] p-3.5 flex items-center justify-between text-xs">
              <div>
                <p class="font-display font-bold text-white">Multi-Tier LED Commercial Facade</p>
                <p class="text-[11px] text-slate-400">The Chennai Mobiles & Digitalhub • In-House Fabrication</p>
              </div>
              <span class="rounded bg-[#f59e0b]/20 border border-[#f59e0b]/40 px-2.5 py-1 text-[11px] font-bold text-[#f59e0b]">
                IP67 Waterproof
              </span>
            </div>
          </div>
        </div>

      </div>

      <!-- Bottom Metrics & Proof Strip (Below both columns) -->
      <div class="mt-16 pt-10">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          {company.highlights.map((item) => (
            <div class="rounded-2xl bg-[#0c101a] border border-[#1e283d] p-5 space-y-1.5 transition-colors hover:border-[#f59e0b]/40">
              <div class="font-display text-2xl sm:text-3xl font-extrabold text-[#f59e0b] glow-amber-text">
                {item.stat}
              </div>
              <div class="font-display text-xs font-bold text-white">
                {item.label}
              </div>
              <p class="text-xs text-slate-400 leading-snug">
                {item.detail}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Day/Night Signage Simulator ("One Live Thing") -->
  <GlowSimulator />

  <!-- Featured Services Section -->
  <section class="py-20 lg:py-28 bg-[#07090e]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#f59e0b]/30 bg-[#f59e0b]/10 px-3 py-1 text-xs font-semibold text-[#f59e0b]">
            Our Capabilities
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Comprehensive Signage Engineering
          </h2>
          <p class="text-sm sm:text-base text-slate-300">
            Every business space communicates through its exterior identity. We design, laser cut, assemble, and mount complete signage systems.
          </p>
        </div>

        <a
          href="/services"
          class="inline-flex items-center gap-2 rounded-xl bg-[#131926] border border-[#2b3954] px-5 py-3 text-xs font-bold text-white hover:bg-[#1a2336] transition-colors shrink-0"
        >
          <span>View All 8 Services</span>
          <span>→</span>
        </a>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredServices.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <!-- Selected Works Showcase (Real installations from vivifysignage) -->
  <section class="py-20 lg:py-28 bg-[#05070a] relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#38bdf8]/30 bg-[#38bdf8]/10 px-3 py-1 text-xs font-semibold text-[#38bdf8]">
            Real Installations
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Selected Signage Works in Coimbatore
          </h2>
          <p class="text-sm sm:text-base text-slate-300">
            Real finished signage boards photographed on-site across commercial hubs, restaurants, and medical centers in Tamil Nadu.
          </p>
        </div>

        <a
          href="/gallery"
          class="inline-flex items-center gap-2 rounded-xl bg-[#f59e0b] px-5 py-3 text-xs font-bold text-black hover:bg-[#fbbf24] transition-colors shrink-0"
        >
          <span>Open Full Gallery</span>
          <span>→</span>
        </a>
      </div>

      <!-- Project Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {spotlightProjects.map((project) => (
          <div class="group relative overflow-hidden rounded-2xl border border-[#1e283d] bg-[#0c101a] transition-colors hover:border-[#f59e0b]/50">
            <div class="relative aspect-[4/3] w-full overflow-hidden bg-[#07090e]">
              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-[#0c101a]/40"></div>
              <div class="absolute top-3 left-3">
                <span class="rounded bg-[#07090e] px-2.5 py-1 text-xs font-semibold text-[#f59e0b]">
                  {project.categoryLabel}
                </span>
              </div>
            </div>

            <div class="p-5 space-y-2">
              <span class="text-xs text-slate-400">{project.location}</span>
              <h3 class="font-display text-lg font-bold text-white group-hover:text-[#f59e0b] transition-colors">
                {project.title}
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed line-clamp-2">
                {project.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Vivify Fabrication Philosophy Section -->
  <section class="py-20 lg:py-28 bg-[#07090e]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Story Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#f59e0b]/30 bg-[#f59e0b]/10 px-3 py-1 text-xs font-semibold text-[#f59e0b]">
            Why Physical Branding Matters
          </div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Elevating Your Space Directly Drives Deal Conversions
          </h2>
          <div class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
            <p>
              Branding your office or commercial space directly affects deals and market perception. Inviting clients into a facility that immediately showcases brand dedication and craftsmanship without saying a single word reinforces credibility from the very first second.
            </p>
            <p>
              When your space is aesthetically commanding, it inspires group pride, unites your team under a shared objective, and establishes landmark status in your neighbourhood. That is the true power of architectural signage.
            </p>
          </div>

          <!-- 4 Core Fabrication Advantages -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <div class="p-5 rounded-xl bg-[#0c101a] space-y-1">
              <h4 class="font-display text-sm font-bold text-white">
                In-House CNC Routing
              </h4>
              <p class="text-xs text-slate-400">
                Precision tooling for micron-accurate acrylic letter cuts and intricate architectural jali facades.
              </p>
            </div>

            <div class="p-5 rounded-xl bg-[#0c101a] space-y-1">
              <h4 class="font-display text-sm font-bold text-white">
                Diamond Polished Edges
              </h4>
              <p class="text-xs text-slate-400">
                Laser-smoothed acrylic returns eliminating rough seams and maximizing 180° light diffusion.
              </p>
            </div>

            <div class="p-5 rounded-xl bg-[#0c101a] space-y-1">
              <h4 class="font-display text-sm font-bold text-white">
                Exterior ACP Cladding
              </h4>
              <p class="text-xs text-slate-400">
                Aluminum composite panels engineered for heat shielding, sound deadening, and architectural sleekness.
              </p>
            </div>

            <div class="p-5 rounded-xl bg-[#0c101a] space-y-1">
              <h4 class="font-display text-sm font-bold text-white">
                Turnkey Site Mounting
              </h4>
              <p class="text-xs text-slate-400">
                Full structural installation across Coimbatore, Tiruppur, Erode, and South India.
              </p>
            </div>
          </div>
        </div>

        <!-- Quote Form Component Column -->
        <div class="lg:col-span-5">
          <QuoteForm />
        </div>

      </div>
    </div>
  </section>
</Layout>
