---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';
import { getWhatsAppInquiryUrl } from '../data/company';
import QuoteForm from '../components/QuoteForm.astro';
---

<Layout
  title="Signage Fabrication Services | Vivify Signage Coimbatore"
  description="Explore our complete range of 8 signage services: 3D Liquid Letters, LED Lighting Boards, ACP Elevation, Acrylic Letters, Stickering, Lollipop Boards, Wayfinding, and CNC Routing."
>
  <!-- Page Header -->
  <section class="relative py-20 lg:py-28 overflow-hidden  bg-[#07090e]">
    <div class="pointer-events-none absolute inset-0 bg-grid-pattern opacity-30"></div>
    <div class="pointer-events-none absolute top-1/4 right-1/4 h-96 w-96 rounded-full bg-[#f59e0b]/10 blur-[130px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#f59e0b]/30 bg-[#f59e0b]/10 px-3.5 py-1.5 text-xs font-semibold font-semibold text-[#f59e0b]">
        Manufacturing Capabilities
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-black tracking-tight text-white max-w-3xl leading-tight">
        Precision Architectural Signage Services
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        From custom acrylic chemistry to heavy structural ACP facade cladding, we provide complete in-house fabrication and installation for all commercial sign types.
      </p>

      <!-- Quick Jump Slat Navigation -->
      <div class="pt-6">
        <p class="text-xs font-bold font-semibold text-slate-400 mb-3">Jump to Service:</p>
        <div class="flex flex-wrap gap-2">
          {services.map((s) => (
            <a
              href={`#${s.slug}`}
              class="px-3 py-1.5 rounded-lg bg-[#0d121c] border border-[#1e283d] text-xs font-medium text-slate-300 hover:text-white hover:border-[#f59e0b] transition-colors"
            >
              {s.title}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Service Sections -->
  <section class="py-16 lg:py-24 bg-[#090b10] space-y-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-28">
      {services.map((service, index) => {
        const isReversed = index % 2 !== 0;
        const whatsappUrl = getWhatsAppInquiryUrl(service.title);

        return (
          <article
            id={service.slug}
            class="scroll-mt-28 rounded-3xl border border-[#1e283d] bg-[#0c101a] p-6 sm:p-10 lg:p-12 overflow-hidden relative "
          >
            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
              
              <!-- Image Column -->
              <div class={`lg:col-span-6 ${isReversed ? 'lg:order-2' : ''}`}>
                <div class="relative overflow-hidden rounded-2xl border border-[#1e283d] bg-[#07090e] aspect-[4/3] group">
                  <img
                    src={service.image}
                    alt={service.title}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    onerror="this.src='/images/signage/1000504398.jpg';"
                  />
                  <div class="absolute inset-0 bg-[#07090e]/60"></div>
                  
                  <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs">
                    <span class="rounded bg-[#07090e]/90 border border-[#2b3954] px-3 py-1 font-bold font-semibold text-[#f59e0b] backdrop-blur-sm">
                      {service.category}
                    </span>
                    <span class="rounded bg-[#07090e]/90 px-3 py-1 text-xs text-slate-300">
                      Crafted in Coimbatore
                    </span>
                  </div>
                </div>
              </div>

              <!-- Information Column -->
              <div class={`lg:col-span-6 space-y-6 ${isReversed ? 'lg:order-1' : ''}`}>
                <div class="space-y-2">
                  <span class="text-xs font-semibold text-[#f59e0b]">
                    {service.category}
                  </span>
                  <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                    {service.title}
                  </h2>
                  <p class="text-sm font-semibold text-slate-300">
                    {service.tagline}
                  </p>
                </div>

                <p class="text-sm text-slate-300 leading-relaxed">
                  {service.longDescription}
                </p>

                <!-- Technical Specs Box -->
                <div class="rounded-xl border border-[#1e283d] bg-[#07090e] p-4 space-y-3 text-xs">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1  pb-2">
                    <span class="text-slate-400 font-bold font-semibold">Illumination Type:</span>
                    <span class="text-[#f59e0b] font-medium">{service.illumination}</span>
                  </div>
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1  pb-2">
                    <span class="text-slate-400 font-bold font-semibold shrink-0">Standard Materials:</span>
                    <span class="text-slate-200 text-right">{service.materials.join(', ')}</span>
                  </div>
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1">
                    <span class="text-slate-400 font-bold font-semibold shrink-0">Best Suited For:</span>
                    <span class="text-slate-200 text-right">{service.applications.join(', ')}</span>
                  </div>
                </div>

                <!-- Features Bullets -->
                <div class="space-y-2">
                  <h4 class="text-xs font-bold text-slate-400">Engineering Advantages:</h4>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-300">
                    {service.features.map((feat) => (
                      <li class="flex items-start gap-2">
                        <svg class="h-4 w-4 text-[#f59e0b] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Action Button -->
                <div class="pt-4 flex flex-wrap items-center gap-4">
                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-xl bg-[#f59e0b] px-6 py-3 text-xs font-bold font-semibold text-black  hover:bg-[#fbbf24] transition-all"
                  >
                    <span>Request Quote for {service.title}</span>
                    <span>→</span>
                  </a>

                  <a
                    href="/gallery"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-400 hover:text-white transition-colors"
                  >
                    View installed examples →
                  </a>
                </div>

              </div>

            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Quote Section -->
  <section class="py-20 bg-[#07090e] ">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <QuoteForm />
    </div>
  </section>
</Layout>
