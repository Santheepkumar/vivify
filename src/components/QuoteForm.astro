---
import { services } from '../data/services';
import { company } from '../data/company';
---

<div class="rounded-2xl border border-[#1e283d] bg-[#0c101a] p-6 sm:p-10  relative overflow-hidden">
  <!-- Subtle decorative ambient corner -->
  <div class="pointer-events-none absolute -top-20 -right-20 h-40 w-40 rounded-full bg-[#f59e0b]/10 blur-2xl"></div>

  <div class="space-y-3 mb-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-[#f59e0b]/30 bg-[#f59e0b]/10 px-3 py-1 text-xs font-semibold font-semibold text-[#f59e0b]">
      Quick Consultation
    </div>
    <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-white">
      Request Free Project Estimate
    </h3>
    <p class="text-xs sm:text-sm text-slate-300">
      Share your project dimensions or signage ideas. We provide on-site measurement and free 3D previews across Coimbatore and Tamil Nadu.
    </p>
  </div>

  <form id="quote-inquiry-form" class="space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      
      <!-- Name -->
      <div>
        <label for="quote-name" class="block text-xs font-medium text-slate-300 mb-1.5">
          Your Name / Business Name *
        </label>
        <input
          type="text"
          id="quote-name"
          name="name"
          required
          minlength="2"
          placeholder="e.g. Anand Kumar (Apex Tech)"
          class="w-full rounded-xl bg-[#07090e] border border-[#2b3954] px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:border-[#f59e0b] focus:outline-none focus:ring-1 focus:ring-[#f59e0b] transition-colors"
        />
        <p id="quote-name-error" class="hidden text-[11px] text-rose-400 font-medium mt-1"></p>
      </div>

      <!-- Phone -->
      <div>
        <label for="quote-phone" class="block text-xs font-medium text-slate-300 mb-1.5">
          Phone / WhatsApp Number *
        </label>
        <input
          type="tel"
          id="quote-phone"
          name="phone"
          required
          minlength="10"
          maxlength="15"
          pattern="[0-9+\\s\\-()]{10,15}"
          placeholder="e.g. +91 98765 43210"
          class="w-full rounded-xl bg-[#07090e] border border-[#2b3954] px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:border-[#f59e0b] focus:outline-none focus:ring-1 focus:ring-[#f59e0b] transition-colors"
        />
        <p id="quote-phone-error" class="hidden text-[11px] text-rose-400 font-medium mt-1"></p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Signage Service Type -->
      <div>
        <label for="quote-service" class="block text-xs font-medium text-slate-300 mb-1.5">
          Signage Type
        </label>
        <select
          id="quote-service"
          name="service"
          class="w-full rounded-xl bg-[#07090e] border border-[#2b3954] px-4 py-2.5 text-xs text-white focus:border-[#f59e0b] focus:outline-none focus:ring-1 focus:ring-[#f59e0b]"
        >
          <option value="General Inquiry">Select a signage category...</option>
          {services.map((s) => (
            <option value={s.title}>{s.title}</option>
          ))}
          <option value="Complete Storefront Branding">Complete Storefront Branding (ACP + LED)</option>
          <option value="Custom Project">Custom Architectural Requirement</option>
        </select>
      </div>

      <!-- Installation Environment -->
      <div>
        <label for="quote-environment" class="block text-xs font-medium text-slate-300 mb-1.5">
          Placement Location
        </label>
        <select
          id="quote-environment"
          name="environment"
          class="w-full rounded-xl bg-[#07090e] border border-[#2b3954] px-4 py-2.5 text-xs text-white focus:border-[#f59e0b] focus:outline-none focus:ring-1 focus:ring-[#f59e0b]"
        >
          <option value="Exterior Building Facade">Exterior Building Facade</option>
          <option value="Retail Shopfront Entrance">Retail Shopfront Entrance</option>
          <option value="Indoor Corporate Reception">Indoor Corporate Reception</option>
          <option value="Highway / Street Pylon">Highway / Street Pylon</option>
          <option value="Hospital / Campus Wayfinding">Hospital / Campus Wayfinding</option>
        </select>
      </div>
    </div>

    <!-- Dimensions & Details -->
    <div>
      <label for="quote-details" class="block text-xs font-medium text-slate-300 mb-1.5">
        Project Dimensions or Requirements
      </label>
      <textarea
        id="quote-details"
        name="details"
        rows="3"
        placeholder="e.g. Approximately 12ft x 4ft board, front lit 3D acrylic letters with ACP base..."
        class="w-full rounded-xl bg-[#07090e] border border-[#2b3954] p-3 text-xs text-white placeholder-slate-500 focus:border-[#f59e0b] focus:outline-none focus:ring-1 focus:ring-[#f59e0b]"
      ></textarea>
    </div>

    <!-- Submit buttons -->
    <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
      <button
        type="submit"
        class="w-full sm:w-auto flex-grow flex items-center justify-center gap-2 rounded-xl bg-[#f59e0b] px-6 py-3.5 text-xs font-bold font-semibold text-black hover:bg-[#fbbf24]  transition-all active:scale-95 cursor-pointer"
      >
        <span>Send to Signage Engineering Team</span>
        <span>→</span>
      </button>

      <a
        href={`tel:${company.phoneRaw}`}
        class="w-full sm:w-auto shrink-0 flex items-center justify-center gap-2 rounded-xl bg-[#131926] border border-[#2b3954] px-5 py-3.5 text-xs font-bold text-white hover:bg-[#1a2336] transition-colors"
      >
        <svg class="h-4 w-4 text-[#f59e0b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Instant Call</span>
      </a>
    </div>

    <!-- Feedback Message -->
    <div id="quote-feedback" class="hidden text-xs p-3 rounded-lg bg-emerald-950/80 border border-emerald-800 text-emerald-300">
      Thank you! Your inquiry is being dispatched via WhatsApp to our estimation team (+91 79045 40645).
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('quote-inquiry-form') as HTMLFormElement | null;
  const feedback = document.getElementById('quote-feedback');
  const nameInput = document.getElementById('quote-name') as HTMLInputElement | null;
  const phoneInput = document.getElementById('quote-phone') as HTMLInputElement | null;
  const nameError = document.getElementById('quote-name-error');
  const phoneError = document.getElementById('quote-phone-error');

  function clearErrors() {
    if (nameError) {
      nameError.textContent = '';
      nameError.classList.add('hidden');
    }
    if (nameInput) {
      nameInput.classList.remove('border-rose-500', 'focus:border-rose-500', 'focus:ring-rose-500');
    }
    if (phoneError) {
      phoneError.textContent = '';
      phoneError.classList.add('hidden');
    }
    if (phoneInput) {
      phoneInput.classList.remove('border-rose-500', 'focus:border-rose-500', 'focus:ring-rose-500');
    }
  }

  if (nameInput) {
    nameInput.addEventListener('input', () => {
      if (nameError && !nameError.classList.contains('hidden')) {
        nameError.textContent = '';
        nameError.classList.add('hidden');
        nameInput.classList.remove('border-rose-500', 'focus:border-rose-500', 'focus:ring-rose-500');
      }
    });
  }

  if (phoneInput) {
    phoneInput.addEventListener('input', () => {
      if (phoneError && !phoneError.classList.contains('hidden')) {
        phoneError.textContent = '';
        phoneError.classList.add('hidden');
        phoneInput.classList.remove('border-rose-500', 'focus:border-rose-500', 'focus:ring-rose-500');
      }
    });
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearErrors();

      const formData = new FormData(form);
      const name = (formData.get('name') as string || '').trim();
      const phone = (formData.get('phone') as string || '').trim();
      const service = formData.get('service') || '';
      const env = formData.get('environment') || '';
      const details = formData.get('details') || '';

      let hasError = false;

      // Validate name
      if (!name || name.length < 2) {
        if (nameError && nameInput) {
          nameError.textContent = 'Please enter your name or business name (min 2 characters).';
          nameError.classList.remove('hidden');
          nameInput.classList.add('border-rose-500', 'focus:border-rose-500', 'focus:ring-rose-500');
          nameInput.focus();
        }
        hasError = true;
      }

      // Validate phone number: must be at least 10 digits
      const digitsOnly = phone.replace(/\D/g, '');
      if (!phone || digitsOnly.length < 10 || digitsOnly.length > 15) {
        if (phoneError && phoneInput) {
          phoneError.textContent = 'Please enter a valid 10-digit phone or WhatsApp number.';
          phoneError.classList.remove('hidden');
          phoneInput.classList.add('border-rose-500', 'focus:border-rose-500', 'focus:ring-rose-500');
          if (!hasError) {
            phoneInput.focus();
          }
        }
        hasError = true;
      }

      if (hasError) {
        if (feedback) {
          feedback.classList.add('hidden');
        }
        return;
      }

      const text = encodeURIComponent(
        `*New Signage Project Quote Request*\n` +
        `• Name: ${name}\n` +
        `• Phone: ${phone}\n` +
        `• Service: ${service}\n` +
        `• Placement: ${env}\n` +
        `• Details: ${details || 'None specified'}\n` +
        `\n(Sent from vivifysignage.com quote form)`
      );

      if (feedback) {
        feedback.classList.remove('hidden');
      }

      // Open WhatsApp dispatch
      window.open(`https://wa.me/917904540645?text=${text}`, '_blank');
    });
  }
</script>
