---
import type { ServiceItem } from '../data/services';
import { getWhatsAppInquiryUrl } from '../data/company';

interface Props {
  service: ServiceItem;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
const whatsappInquiry = getWhatsAppInquiryUrl(service.title);
---

<article 
  id={service.slug}
  class={`group relative overflow-hidden rounded-2xl bg-[#0c101a] border border-[#1e283d] transition-colors duration-200 hover:border-[#f59e0b] flex flex-col justify-between ${
    featured ? 'lg:col-span-2' : ''
  }`}
>
  <!-- Card Media Container -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#07090e]">
    <img 
      src={service.image} 
      alt={service.title} 
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      onerror="this.src='/images/signage/1000504398.jpg';"
    />
    <div class="absolute inset-0 bg-[#0c101a]/40"></div>

    <!-- Category Tag -->
    <div class="absolute top-4 left-4">
      <span class="inline-flex items-center rounded bg-[#07090e] px-2.5 py-1 text-xs font-semibold text-[#f59e0b]">
        {service.category}
      </span>
    </div>
  </div>

  <!-- Content Container -->
  <div class="p-6 sm:p-8 flex flex-col flex-grow justify-between space-y-6">
    <div class="space-y-3">
      <h3 class="font-display text-2xl font-bold tracking-tight text-white group-hover:text-[#f59e0b] transition-colors">
        {service.title}
      </h3>
      <p class="text-xs text-slate-400 leading-snug">
        {service.tagline}
      </p>
      <p class="text-sm text-slate-300 leading-relaxed pt-1">
        {service.description}
      </p>

      <!-- Key Specs Badges -->
      <div class="pt-2 flex flex-wrap gap-2 text-xs text-slate-300">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#131926]">
          <svg class="h-3.5 w-3.5 text-[#f59e0b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          {service.illumination.split(' ')[0]} {service.illumination.split(' ')[1] || 'Lighting'}
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#131926]">
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          {service.materials[0]}
        </span>
      </div>
    </div>

    <!-- Features List -->
    <ul class="space-y-2 pt-2 text-xs text-slate-300">
      {service.features.slice(0, 3).map((feat) => (
        <li class="flex items-start gap-2">
          <svg class="h-4 w-4 text-[#f59e0b] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{feat}</span>
        </li>
      ))}
    </ul>

    <!-- Action Buttons -->
    <div class="pt-4 flex items-center justify-between gap-3 ">
      <a
        href={`/services#${service.slug}`}
        class="text-xs font-semibold text-slate-300 hover:text-white flex items-center gap-1 transition-colors"
      >
        Specifications →
      </a>

      <a
        href={whatsappInquiry}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg bg-[#f59e0b] px-3.5 py-2 text-xs font-bold text-black hover:bg-[#fbbf24] transition-colors"
      >
        <span>Quote on WhatsApp</span>
        <span>→</span>
      </a>
    </div>
  </div>
</article>
