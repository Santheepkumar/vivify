---
import { company } from '../data/company';
import { services } from '../data/services';
---

<footer class=" bg-[#05070a] text-slate-400 relative overflow-hidden">
  <!-- Subtle architectural ambient glow -->
  <div class="pointer-events-none absolute -top-40 right-1/4 h-96 w-96 rounded-full bg-[#f59e0b]/5 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 left-1/4 h-96 w-96 rounded-full bg-[#38bdf8]/5 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-4 space-y-6">
        <a href="/" class="flex items-center gap-3">
          <div class="flex items-center justify-center h-12 w-auto overflow-hidden rounded bg-[#0d121c] p-1 border border-[#1e283d]">
            <img 
              src="/images/logo.png" 
              alt="Vivify Signage" 
              class="h-10 w-auto object-contain"
              onerror="this.style.display='none';"
            />
          </div>
          <span class="font-display text-xl font-bold tracking-tight text-white">
            VIVIFY SIGNAGE
          </span>
        </a>

        <p class="text-sm leading-relaxed text-slate-300">
          Premier LED & Glow Sign Boards makers in Coimbatore, Tamil Nadu. Elevating retail shopfronts, corporate headquarters, and architectural facades through precision 3D acrylic letters, modern ACP elevation, and all-weather illuminated branding.
        </p>

        <div class="pt-2 flex flex-col gap-2 text-xs">
          <div class="flex items-center gap-2 text-slate-300">
            <span class="flex h-2 w-2 rounded-full bg-emerald-400"></span>
            <span>Workshop & Display Studio Open in Ganapathy, Coimbatore</span>
          </div>
          <p class="text-slate-400 text-xs">Mon–Fri: {company.hours.weekdays} | Sat: {company.hours.saturday}</p>
        </div>
      </div>

      <!-- Signage Services Links -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-display text-sm font-bold font-semibold text-white">
          Signage Solutions
        </h4>
        <ul class="space-y-2.5 text-sm">
          {services.slice(0, 6).map((service) => (
            <li>
              <a 
                href={`/services#${service.slug}`} 
                class="hover:text-[#f59e0b] transition-colors flex items-center gap-1.5"
              >
                <span class="text-slate-600 text-xs">›</span>
                {service.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-xs font-semibold text-[#f59e0b] hover:underline flex items-center gap-1 pt-1">
              View all 8 services →
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick Navigation -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="font-display text-sm font-bold font-semibold text-white">
          Navigation
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Company</a></li>
          <li><a href="/services" class="hover:text-white transition-colors">Services & Craft</a></li>
          <li><a href="/gallery" class="hover:text-white transition-colors">Project Gallery</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Us</a></li>
          <li><a href="/contact#quote" class="hover:text-[#f59e0b] transition-colors font-medium">Request Quote</a></li>
        </ul>
      </div>

      <!-- Office & Contact Details -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-display text-sm font-bold font-semibold text-white">
          Workshop Address
        </h4>
        <address class="not-italic text-sm text-slate-300 space-y-3 leading-relaxed">
          <p class="flex items-start gap-2.5">
            <svg class="h-5 w-5 text-[#f59e0b] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{company.address.full}</span>
          </p>

          <p class="flex items-center gap-2.5">
            <svg class="h-5 w-5 text-[#f59e0b] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${company.phoneRaw}`} class="hover:text-white font-semibold tracking-wide">
              {company.phone}
            </a>
          </p>

          <p class="flex items-center gap-2.5">
            <svg class="h-5 w-5 text-[#f59e0b] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${company.email}`} class="hover:text-white text-xs">
              {company.email}
            </a>
          </p>
        </address>

        <div class="pt-2">
          <a
            href={company.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-[#25D366]/20 border border-[#25D366]/40 px-3.5 py-2 text-xs font-semibold text-[#25D366] hover:bg-[#25D366] hover:text-black transition-all"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.076-1.528-.276-.902-.355-1.597-.91-2.072-1.428-.475-.518-.94-1.33-.94-2.193 0-.863.454-1.288.618-1.464.164-.176.359-.22.478-.22.12 0 .24.002.345.008.11.006.257-.042.403.31.15.361.512 1.25.557 1.341.045.091.075.197.015.316-.06.12-.09.195-.179.3-.09.105-.189.234-.27.315-.09.09-.185.188-.08.368.106.18.47 775 1.009 1.254.693.617 1.278.808 1.458.898.18.09.285.075.39-.045.106-.12.45-.525.57-.705.12-.18.24-.15.405-.09.165.06 1.05.495 1.23.585.18.09.3.135.345.21.045.075.045.435-.099.84z"/>
            </svg>
            WhatsApp Instant Inquiry
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Architecture Bar -->
    <div class="mt-14 pt-8  flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>
        © {new Date().getFullYear()} <span class="text-slate-300 font-semibold">Vivify Signage</span>. All rights reserved. Registered Signage Manufacturer, Coimbatore.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-400 transition-colors">Terms of Service</a>
        <a href="#top" class="hover:text-[#f59e0b] transition-colors flex items-center gap-1 font-medium">
          Back to Top ↑
        </a>
      </div>
    </div>
  </div>
</footer>
